[Script]
# One self-hosted JSON cleaner for startup ads, popup ads, and feed ad objects.
Plus_Bilibili_Clean = type=http-response,requires-body=1,max-size=-1,script-path=https://gist.githubusercontent.com/Y123456-hzy/dd342a1a61daf8c250b112faa1381918/raw/gy-startup-ads-clean.js,pattern=^https?:\/\/(app\.bili(?:bili\.com|api\.net)\/x\/v2\/splash|app\.bili(?:bili\.com|api\.net)\/x\/resource\/show\/tab(?:\/v2|\/bubble)?\?|app\.bili(?:bili\.com|api\.net)\/x\/resource\/patch\/tab\/v2\?|app\.bili(?:bili\.com|api\.net)\/x\/v2\/account\/mine(?:\/ipad)?\?|app\.bili(?:bili\.com|api\.net)\/x\/v2\/feed\/index(?:\/story)?\?|api\.bilibili\.com\/x\/web-interface\/wbi\/index\/top\/feed\/rcmd\?|app\.bili(?:bili\.com|api\.net)\/x\/v2\/search(?:\/square)?\?|(?:api|app)\.bili(?:bili\.com|api\.net)\/x\/v2\/reply(?:\/(?:wbi\/main|main|reply|hot|dialog\/cursor|detail))?\?|api\.(bilibili|biliapi)\.(com|net)\/pgc\/page\/(bangumi|cinema\/tab)|api\.bilibili\.com\/pgc\/view\/v2\/app\/season\?|api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\?|api\.live\.bilibili\.com\/xlive\/app-room\/v1\/index\/getInfoByRoom|api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/dynamic_(history|new)\?)

