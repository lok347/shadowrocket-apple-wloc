#!name=GY AdBlock MITM Plus
#!desc=Broader self-hosted MITM ad blocking for Shadowrocket: startup ads, popups, banners, feed ad JSON, and common ad SDK calls.
#!author=Codex
#!homepage=https://gist.github.com/Y123456-hzy/dd342a1a61daf8c250b112faa1381918
#!system=ios

# Usage:
# 1. Upload gy-adblock-mitm-lite.sgmodule and gy-startup-ads-clean.js to the same Gist.
# 2. Import this module raw URL in Shadowrocket:
#    https://gist.githubusercontent.com/Y123456-hzy/dd342a1a61daf8c250b112faa1381918/raw/gy-adblock-mitm-lite.sgmodule
# 3. Enable HTTPS Decryption / MITM and trust the Shadowrocket CA certificate in iOS.
# 4. This Plus module is more aggressive than Lite. If an app breaks, disable Plus and fall back to Lite.

[General]
always-reject-url-rewrite = false
force-http-engine-hosts = %APPEND% app.bilibili.com,app.biliapi.net,api.bilibili.com,api.biliapi.net,api.vc.bilibili.com,api.live.bilibili.com,manga.bilibili.com,grpc.biliapi.net,upos-sz-static.bilivideo.com,api.zhihu.com,www.zhihu.com,web-render.zhihu.com,page-info.zhihu.com,appcloud2.in.zhihu.com,weibointl.api.weibo.cn,api.weibo.cn,mapi.weibo.com,mapi.weibo.cn,sdkapp.uve.weibo.com,wbapp.uve.weibo.com,edith.xiaohongshu.com,www.xiaohongshu.com,acs.m.taobao.com,guide-acs.m.taobao.com,poplayer.template.alibaba.com,heic.alicdn.com,gw.alicdn.com,cloud.video.taobao.com,acs.m.goofish.com,api.m.jd.com,popup3.jd.com,router-app-api.jdcloud.com,wmapi.meituan.com,flowplus.meituan.net,api.mcd.cn,dynamicad.kfc.com.cn,orders.kfc.com.cn,res.kfc.com.cn,api.yangkeduo.com,api.pinduoduo.com,images.pinduoduo.com,api.xueqiu.com,open.xueqiu.com,promo.xueqiu.com,dict.youdao.com,api-overmind.youdao.com,cdke.youdao.com,m.ctrip.com,homefront.qunar.com,client.qunar.com,newclient.map.baidu.com,m5.amap.com,optimus-ads.amap.com,amap-aos-info-nogw.amap.com,mobads.baidu.com,afd.baidu.com,api-access.pangolin-sdk-toutiao.com,api.pangolin-sdk-toutiao.com,api-access.pangolin-sdk-toutiao1.com,ether-pack.pangolin-sdk-toutiao.com,sf3-fe-tos.pglstatp-toutiao.com,api.zhuishushenqi.com,api.sfacg.com,magev6.if.qidian.com,interface.music.163.com,interface3.music.163.com,app-api.smzdm.com,homepage-api.smzdm.com,haojia-api.smzdm.com,s-api.smzdm.com,baike-api.smzdm.com,api.coolapk.com,tiebac.baidu.com,c.tieba.baidu.com,pan.baidu.com,mime.baidu.com,api.douban.com,app.dewu.com,api.dangdang.com,e.dangdang.com,api.m.mi.com,api.jr.mi.com,home.mi.com,shop-api.retail.mi.com,shopapi.io.mi.com,api-mifit-cn2.zepp.com,api-mifit.huami.com,hd.mina.mi.com,info.mina.mi.com,info.mina.xiaoaisound.com,mi.gdt.qq.com,win.gdt.qq.com,open.e.kuaishou.com,api.gotokeep.com,api.kkmh.com,api.kurobbs.com,capis*.didapinche.com,fmapp.chinafamilymart.com.cn,gateway.abite.com,gateway.cotticoffee.com,maicai.api.ddxq.mobi,api.rr.tv,api.juxingclu