#!name=GY AdBlock v6
#!desc=Layered blocking: DIRECT guards -> maintained AWAvenue RULE-SET -> static fallback -> precise rewrites -> allowlisted response cleaning. Coolapk bypasses MITM.
#!author=Y123456-hzy
#!homepage=https://gist.github.com/Y123456-hzy/dd342a1a61daf8c250b112faa1381918
#!system=ios

[General]
always-reject-url-rewrite = false
force-http-engine-hosts = %APPEND% app.bilibili.com,app.biliapi.net,api.bilibili.com,api.vc.bilibili.com,acs.m.taobao.com,guide-acs.m.taobao.com,acs.m.goofish.com,poplayer.template.alibaba.com,api.m.jd.com,api.yangkeduo.com,api.pinduoduo.com,api.zhihu.com,web-render.zhihu.com,wmapi.meituan.com,api.xueqiu.com,api.mcd.cn,res.kfc.com.cn,dynamicad.kfc.com.cn,m5.amap.com,newclient.map.baidu.com,app.58.com,api-access.pangolin-sdk-toutiao.com,api-access.pangolin-sdk-toutiao1.com,api-access.pangolin-sdk-toutiao-b.com,api.pangolin-sdk-toutiao.com,api.pangolin-sdk-toutiao1.com,api.pangolin-sdk-toutiao-b.com,gromore.pangolin-sdk-toutiao.com,ether-pack.pangolin-sdk-toutiao.com,sf3-fe-tos.pglstatp-toutiao.com,sf6-fe-tos.pglstatp-toutiao.com,mi.gdt.qq.com,v2mi.gdt.qq.com,win.gdt.qq.com,mobads.baidu.com,afd.baidu.com,optimus-ads.amap.com,amap-aos-info-nogw.amap.com,images.pinduoduo.com,router-app-api.jdcloud.com,ad.12306.cn,api.chelaile.net.cn,web.chelaile.net.cn,app-gw.csdn.net,gab.122.gov.cn,ssp.soulapp.cn,fuss10.elemecdn.com

[Rule]
# --- Layer 1: DIRECT guards (must stay first; first match wins). ---
# Coolapk SDK handshakes, config and telemetry must not be domain-rejected,
# otherwise the SDKs retry-storm and freeze the app. Ad payload fetches on
# these domains are still blocked by the precise URL Rewrites below.
DOMAIN-SUFFIX,gdt.qq.com,DIRECT
DOMAIN-SUFFIX,e.qq.com,DIRECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,DIRECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,DIRECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao2.com,DIRECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao3.com,DIRECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao4.com,DIRECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao5.com,DIRECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,DIRECT
DOMAIN-SUFFIX,umeng.com,DIRECT
DOMAIN-SUFFIX,umengcloud.com,DIRECT
DOMAIN,umengacs.m.taobao.com,DIRECT
DOMAIN,umengjmacs.m.taobao.com,DIRECT
DOMAIN,adashbc.ut.taobao.com,DIRECT
DOMAIN,adashxgc.ut.taobao.com,DIRECT
# Bytedance TNC config service: required by Pangle SDK startup.
DOMAIN,tnc0-aliec2.zijieapi.com,DIRECT
DOMAIN,tnc0-alisc1.zijieapi.com,DIRECT
DOMAIN,tnc0-bjlgy.zijieapi.com,DIRECT
DOMAIN,tnc3-aliec2.zijieapi.com,DIRECT
DOMAIN,tnc3-alisc1.zijieapi.com,DIRECT
DOMAIN,tnc3-alisc2.zijieapi.com,DIRECT
DOMAIN,tnc3-bjlgy.zijieapi.com,DIRECT

# --- Layer 2: maintained community rule-set (TG-Twilight/AWAvenue-Ads-Rule). ---
# 900+ ad/tracking domains, continuously updated upstream. Guards above
# shield the Coolapk-sensitive SDK domains from this list.
RULE-SET,https://raw.githubusercontent.com/TG-Twilight/AWAvenue-Ads-Rule/main/Filters/AWAvenue-Ads-Rule-Surge-RULE-SET.list,REJECT

# --- Layer 3: static fallback (works even if the RULE-SET fails to download). ---
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,adservice.google.com,REJECT
DOMAIN-SUFFIX,admob.com,REJECT
DOMAIN-SUFFIX,adsrvr.org,REJECT
DOMAIN-SUFFIX,adnxs.com,REJECT
DOMAIN-SUFFIX,criteo.com,REJECT
DOMAIN-SUFFIX,pubmatic.com,REJECT
DOMAIN-SUFFIX,rubiconproject.com,REJECT
DOMAIN-SUFFIX,taboola.com,REJECT
DOMAIN-SUFFIX,outbrain.com,REJECT
DOMAIN-SUFFIX,moatads.com,REJECT
DOMAIN-SUFFIX,doubleverify.com,REJECT
DOMAIN-SUFFIX,applovin.com,REJECT
DOMAIN-SUFFIX,inmobi.com,REJECT
DOMAIN-SUFFIX,unityads.unity3d.com,REJECT
DOMAIN-SUFFIX,pangolin-dsp-toutiao.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
DOMAIN-SUFFIX,ad.toutiao.com,REJECT
DOMAIN-SUFFIX,gdtimg.cn,REJECT
DOMAIN-SUFFIX,gdtimg.com,REJECT
DOMAIN-SUFFIX,mobads.baidu.com,REJECT
DOMAIN-SUFFIX,afd.baidu.com,REJECT
DOMAIN-SUFFIX,cpro.baidu.com,REJECT
DOMAIN-SUFFIX,pos.baidu.com,REJECT
DOMAIN-SUFFIX,wangmeng.baidu.com,REJECT
DOMAIN-SUFFIX,eclick.baidu.com,REJECT
DOMAIN-SUFFIX,alimama.com,REJECT
DOMAIN-SUFFIX,mmstat.com,REJECT
DOMAIN-SUFFIX,adkwai.com,REJECT
DOMAIN-SUFFIX,adbkwai.com,REJECT
DOMAIN-SUFFIX,adukwai.com,REJECT
DOMAIN-SUFFIX,open.e.kuaishou.com,REJECT
DOMAIN-SUFFIX,sigmob.cn,REJECT
DOMAIN-SUFFIX,datads.cn,REJECT
DOMAIN-SUFFIX,ubixioe.com,REJECT
DOMAIN-SUFFIX,fancyapi.com,REJECT
DOMAIN-SUFFIX,advlion.com,REJECT
DOMAIN,cm.bilibili.com,REJECT
DOMAIN,data.bilibili.com,REJECT
DOMAIN,popup3.jd.com,REJECT

[URL Rewrite]
# Pangolin: block ad/config/material fetches, not telemetry batches.
^https?:\/\/api-access\.pangolin-sdk-toutiao(?:\d+|-b)?\.com\/api\/ad\/union\/sdk\/get_ads\/ - reject-dict
^https?:\/\/api-access\.pangolin-sdk-toutiao(?:\d+|-b)?\.com\/api\/ad\/union\/sdk\/settings\/ - reject-dict
^https?:\/\/api\.pangolin-sdk-toutiao(?:\d+|-b)?\.com\/api\/ad\/union\/sdk\/get_ads\/ - reject-dict
^https?:\/\/api\.pangolin-sdk-toutiao(?:\d+|-b)?\.com\/api\/ad\/union\/sdk\/settings\/ - reject-dict
^https?:\/\/gromore\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/mediation\/(?:config|exchange)\/ - reject-dict
^https?:\/\/ether-pack\.pangolin-sdk-toutiao\.com\/union\/endcard\/ - reject-200
^https?:\/\/sf\d+-fe-tos\.pglstatp-toutiao\.com\/obj\/ad-pattern\/ - reject-200

# GDT: block ad view/click payloads without rejecting the whole SDK domain.
^https?:\/\/(?:mi|v2mi|win)\.gdt\.qq\.com\/gdt_(?:mview|view|click)\.fcg - reject-dict

# High-confidence application ad endpoints.
^https?:\/\/mobads\.baidu\.com\/.* - reject-dict
^https?:\/\/afd\.baidu\.com\/afd\/entry - reject-dict
^https?:\/\/optimus-ads\.amap\.com\/ - reject-200
^https?:\/\/m\d\.amap\.com\/ws\/valueadded\/alimama\/splash_screen - reject-200
^https?:\/\/amap-aos-info-nogw\.amap\.com\/ws\/aos\/alimama\/ - reject-200
^https?:\/\/images\.pinduoduo\.com\/marketing_api - reject-200
^https?:\/\/router-app-api\.jdcloud\.com\/v\d\/board\/routerAppSplash - reject-200
^https?:\/\/ad\.12306\.cn\/ad\/ser\/getAdList$ - reject-dict
^https?:\/\/api\.chelaile\.net\.cn\/(?:adpub|goocity\/advert) - reject-dict
^https?:\/\/web\.chelaile\.net\.cn\/api\/adpub - reject-dict
^https?:\/\/app-gw\.csdn\.net\/cms-app\/v\d\/home_page\/open_advertisement - reject-dict
^https?:\/\/gab\.122\.gov\.cn\/eapp\/m\/sysquery\/adver$ - reject-dict
^https?:\/\/ssp\.soulapp\.cn\/api\/q\? - reject-dict
^https?:\/\/fuss10\.elemecdn\.com\/.+\.mp4 - reject-200

[Script]
GY_Bilibili_Clean = type=http-response,requires-body=1,max-size=3145728,script-path=https://gist.githubusercontent.com/Y123456-hzy/dd342a1a61daf8c250b112faa1381918/raw/gy-startup-ads-clean.js,pattern=^https?:\/\/(?:app\.bili(?:bili\.com|api\.net)\/x\/(?:v2\/splash|v2\/feed\/index|resource\/show\/tab|resource\/patch\/tab|v2\/search|v2\/account\/mine)|api\.bilibili\.com\/x\/web-interface\/wbi\/index\/top\/feed\/rcmd|api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/dynamic_)
GY_Shopping_Clean = type=http-response,requires-body=1,max-size=3145728,script-path=https://gist.githubusercontent.com/Y123456-hzy/dd342a1a61daf8c250b112faa1381918/raw/gy-startup-ads-clean.js,pattern=^https?:\/\/(?:(?:acs|guide-acs)\.m\.taobao\.com\/gw\/mtop\.(?:taobao\.wireless\.home\.(?:splash|newface)\.awesome\.get|alibaba\.advertisementservice\.getadv|taobao\.idle\.home\.welcome|fliggy\.crm\.screen\.(?:allresource|predict))|acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlecommerce\.splash|poplayer\.template\.alibaba\.com\/\w+\.json|api\.m\.jd\.com\/.*(?:\?|&)functionId=(?:deliverLayer|homeAreaPop|home_launchConfig|lite_advertising|queryMaterialAdverts|smart_delivery_strategy|start|stationPullService|uniformRecommend\d*|welcomeHome)(?:&|$)|api\.(?:yangkeduo|pinduoduo)\.com\/api\/cappuccino\/(?:splash|querySplash))
GY_Zhihu_Clean = type=http-response,requires-body=1,max-size=3145728,script-path=https://gist.githubusercontent.com/Y123456-hzy/dd342a1a61daf8c250b112faa1381918/raw/gy-startup-ads-clean.js,pattern=^https?:\/\/(?:api\.zhihu\.com\/(?:commercial_api|fringe\/ad|topstory)|web-render\.zhihu\.com\/topstory\/recommend)
GY_Startup_Clean = type=http-response,requires-body=1,max-size=3145728,script-path=https://gist.githubusercontent.com/Y123456-hzy/dd342a1a61daf8c250b112faa1381918/raw/gy-startup-ads-clean.js,pattern=^https?:\/\/(?:wmapi\.meituan\.com\/api\/v\d+\/(?:loadInfo|startpicture)|[^/]+\.meituan\.com\/api\/v\d\/(?:openscreen|loadInfo|startpicture)|api\.xueqiu\.com\/(?:lightsnow|snowpard)\/|api\.mcd\.cn\/bff\/portal\/(?:home\/splash|richpop)|res\.kfc\.com\.cn\/advertisement|dynamicad\.kfc\.com\.cn\/api|m\d\.amap\.com\/ws\/(?:shield\/dsp\/app\/startup\/init|valueadded\/alimama\/splash_screen)|newclient\.map\.baidu\.com\/client\/(?:crossmarketing|push\/getPushMsg)|app\.58\.com\/api\/home\/(?:advertising|appadv|invite\/popupAdv))

[MITM]
enable = true
hostname = %APPEND% app.bilibili.com,app.biliapi.net,api.bilibili.com,api.vc.bilibili.com,acs.m.taobao.com,guide-acs.m.taobao.com,acs.m.goofish.com,poplayer.template.alibaba.com,api.m.jd.com,api.yangkeduo.com,api.pinduoduo.com,api.zhihu.com,web-render.zhihu.com,wmapi.meituan.com,api.xueqiu.com,api.mcd.cn,res.kfc.com.cn,dynamicad.kfc.com.cn,m5.amap.com,newclient.map.baidu.com,app.58.com,api-access.pangolin-sdk-toutiao.com,api-access.pangolin-sdk-toutiao1.com,api-access.pangolin-sdk-toutiao-b.com,api.pangolin-sdk-toutiao.com,api.pangolin-sdk-toutiao1.com,api.pangolin-sdk-toutiao-b.com,gromore.pangolin-sdk-toutiao.com,ether-pack.pangolin-sdk-toutiao.com,sf3-fe-tos.pglstatp-toutiao.com,sf6-fe-tos.pglstatp-toutiao.com,mi.gdt.qq.com,v2mi.gdt.qq.com,win.gdt.qq.com,mobads.baidu.com,afd.baidu.com,optimus-ads.amap.com,amap-aos-info-nogw.amap.com,images.pinduoduo.com,router-app-api.jdcloud.com,ad.12306.cn,api.chelaile.net.cn,web.chelaile.net.cn,app-gw.csdn.net,gab.122.gov.cn,ssp.soulapp.cn,fuss10.elemecdn.com
